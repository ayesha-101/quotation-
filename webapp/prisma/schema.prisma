generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles are data, not code: an Admin can create new ones (e.g. "Regional
// Manager") with their own permission set and, if it should take part in
// GP approval routing, its own margin range. The six built-in roles are
// seeded rows (isSystem = true) with these same flags, not special-cased
// in application logic — see lib/permissions.ts for how gp% picks a role.
model Role {
  id                  String   @id @default(cuid())
  name                String   @unique
  isSystem            Boolean  @default(false)
  isAdmin             Boolean  @default(false)
  canManageCatalog    Boolean  @default(false)
  canManageUsers      Boolean  @default(false)
  canCreateQuotations Boolean  @default(false)
  isSalesman          Boolean  @default(false)
  canApproveGp        Boolean  @default(false)
  // Margin range this role approves, only meaningful when canApproveGp.
  // Null gpMin = no lower bound, null gpMax = no upper bound. Ranges are
  // validated not to overlap when a role is created/edited.
  gpMin               Float?
  gpMax               Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users     User[]
  approvals Approval[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])
  isActive      Boolean   @default(true)
  mustResetPassword Boolean @default(true)
  failedAttempts Int      @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?

  quotationsAsSalesman Quotation[] @relation("QuotationSalesman")
  quotationsCreated    Quotation[] @relation("QuotationCreatedBy")
  approvalDecisions    Approval[]  @relation("ApprovalDecidedBy")
  passwordResetTokens  PasswordResetToken[]
}

// A business unit (Electrical today; more added from /admin/departments as
// each one's own catalog/quotation workflow gets defined — see the comment
// on CatalogItem/Quotation.departmentId). isAdmin roles see across every
// department; every other role is scoped to its user's own department by
// a departmentId filter at each query site, not by anything on Role itself
// — a role's permission bits stay company-wide, only the *data* is scoped.
model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  // Printed quote-number prefix, e.g. "BMTC-JIH" — kept editable per
  // department since each one may follow its own existing numbering
  // convention once that's known.
  quotePrefix String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  catalogItems  CatalogItem[]
  quotations    Quotation[]
  quoteSequence QuoteSequence?
}

// Self-service "forgot password" flow. Only tokenHash (SHA-256 of the raw
// token emailed to the user) is stored, never the raw token itself, so a
// database read alone can't be used to reset an account. Single-use
// (usedAt) and short-lived (expiresAt) — see lib/reset-token.ts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// The pricing catalog: one row per sellable item. Landed cost and sell
// price are computed from these fields at quotation time (see the pricing
// engine ported from the original Artifact's computeLinePricing()), not
// stored here — only the inputs to that calculation live on the item.
model CatalogItem {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  code         String
  description  String
  brand        String
  uom          String
  exWork       String   @default("")
  currency     String   @default("USD")
  listPrice    Float    @default(0)
  disPct       Float    @default(0)
  exRate       Float    @default(3.68)
  freightPct   Float    @default(0)
  dutyPct      Float    @default(0)
  adPct        Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([departmentId, code, brand])
}

// Backs the human-readable quote number (<department.quotePrefix>-YYYYMM-
// <seq>) — one row per department, each incremented with an atomic upsert
// so two concurrent saves in the same department can never get the same
// number.
model QuoteSequence {
  departmentId String     @id
  department   Department @relation(fields: [departmentId], references: [id])
  value        Int        @default(1390)
}

enum QuotationStatus {
  DRAFT
  QUOTED
  UNDER_NEGOTIATION
  LOST
  CONVERTED_TO_LPO
}

model Quotation {
  id              String          @id @default(cuid())
  departmentId    String
  department      Department      @relation(fields: [departmentId], references: [id])
  quoteNo         String          @unique
  revision        Int             @default(0)
  status          QuotationStatus @default(DRAFT)
  salesmanId      String
  salesman        User            @relation("QuotationSalesman", fields: [salesmanId], references: [id])
  to              String          @default("")
  attention       String          @default("")
  reference       String          @default("")
  project         String          @default("")
  consultant      String          @default("")
  client          String          @default("")
  subject         String          @default("")
  telNo           String          @default("")
  faxNo           String          @default("")
  mobNo           String          @default("")
  delivery        String          @default("")
  deliveryPlace   String          @default("")
  validity        String          @default("")
  paymentTerms    String          @default("")
  prepName        String          @default("")
  prepTitle       String          @default("")
  prepMobile      String          @default("")
  pricingControls Json
  quoteValue      Float
  vat             Float
  totalValue      Float
  gp              Float
  customerLpoNo   String          @default("")
  lpoMismatch     Boolean         @default(false)
  // The customer's LPO PDF, kept as a record and for side-by-side manual
  // comparison — stored directly in Postgres (no separate file-storage
  // service) since these documents are small. Text is extracted once on
  // upload so the detail page doesn't re-parse the PDF on every view.
  customerLpoFileName String?
  customerLpoFileData Bytes?
  customerLpoFileText String?
  // Zoho CRM push-sync: the Account selected in the "To" autocomplete
  // (used to link the Deal to the right Account) and the Deal Zoho hands
  // back once we create it. Both stay null if CRM sync fails or the
  // customer name wasn't picked from a CRM match — quotation creation
  // never blocks on this.
  crmAccountId    String?
  zohoDealId      String?
  createdAt       DateTime        @default(now())
  lastEditedAt    DateTime        @updatedAt
  createdById     String
  createdBy       User            @relation("QuotationCreatedBy", fields: [createdById], references: [id])

  lines      QuotationLine[]
  auditLog   QuotationAuditEntry[]
  approvals  Approval[]
  revisions  RevisionSnapshot[]
}

// A lightweight record of what a quotation's value was before each
// revision superseded it — not a full line-item snapshot, just enough
// for the "Revision history" list (mirrors the original Artifact).
model RevisionSnapshot {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revision    Int
  value       Float
  at          DateTime
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  position    Int
  code        String    @default("")
  description String    @default("")
  brand       String    @default("")
  uom         String    @default("")
  qty         Float     @default(0)
  speDiscPct  Float     @default(0)
  marginPct   Float     @default(35)
  unitLanded  Float     @default(0)
  unitSell    Float     @default(0)
  lineTotal   Float     @default(0)
  manual      Boolean   @default(false)
  custQty     Float?
  custPrice   Float?
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id          String         @id @default(cuid())
  quotationId String
  quotation   Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role           @relation(fields: [roleId], references: [id])
  status      ApprovalStatus @default(PENDING)
  requestedAt DateTime       @default(now())
  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  comment     String?
}

// Append-only, hash-linked audit trail: every significant action across
// the app (not just quotations) gets one record here, and each record's
// hash covers its own fields plus the previous record's hash — so editing,
// deleting, or reordering any entry breaks the chain from that point on.
// Unlike the original Artifact's version (client-side only, disclosed as
// provable-internal-consistency-only), this is appended and hashed by the
// server, never by the browser — see lib/security-chain.ts.
model SecurityChainRecord {
  seq      Int      @id @default(autoincrement())
  at       DateTime @default(now())
  actor    String
  action   String
  resource String
  outcome  String
  prevHash String
  hash     String
}

model QuotationAuditEntry {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  who         String
  action      String
  at          DateTime  @default(now())
}
